# coding-orchestrator configuration. Copy to .env and fill in only what you use.
# Never commit .env. Placeholders only below.

# --- Core -------------------------------------------------------------------
# ORCHESTRATOR_HOME=~/.local/share/coding-orchestrator   # default: $XDG_DATA_HOME/coding-orchestrator
# ORCHESTRATOR_DB_URL=sqlite:////home/you/.local/share/coding-orchestrator/orchestrator.db
ORCHESTRATOR_BIND_HOST=127.0.0.1
ORCHESTRATOR_BIND_PORT=8321
# ORCHESTRATOR_TOKEN=change-me            # required if BIND_HOST is not localhost
ORCHESTRATOR_LOG_LEVEL=INFO
ORCHESTRATOR_MAX_PARALLEL_RUNS=2
ORCHESTRATOR_MAX_PARALLEL_RUNS_PER_PROJECT=1
ORCHESTRATOR_ENABLE_SCHEDULER=true
ORCHESTRATOR_ENABLE_WORKER=true
# ORCHESTRATOR_WORKTREE_ROOT=
# ORCHESTRATOR_ARTIFACT_ROOT=
# ORCHESTRATOR_LOG_ROOT=
# ORCHESTRATOR_MEMORY_ROOT=
ORCHESTRATOR_RUN_RETENTION_DAYS=30
ORCHESTRATOR_GIT_USER_NAME=coding-orchestrator
ORCHESTRATOR_GIT_USER_EMAIL=orchestrator@localhost
ORCHESTRATOR_DEFAULT_BASE_BRANCH=main
# ORCHESTRATOR_FRONTEND_DIST=web/dist
ORCHESTRATOR_AUTOSTART_BROWSER=false

# --- Gates (all off by default) ---------------------------------------------
ORCHESTRATOR_MERGE_ENABLED=false
ORCHESTRATOR_AUTO_MERGE_ENABLED=false
ORCHESTRATOR_SUPERVISOR_MICROFIXES_ENABLED=false
ORCHESTRATOR_ALLOW_GUI_COMMANDS=false

# --- Prompt budgets (approximate tokens) -------------------------------------
ORCHESTRATOR_MAX_PROMPT_CONTEXT_TOKENS=60000
ORCHESTRATOR_MAX_LOG_TOKENS=4000
ORCHESTRATOR_MAX_DIFF_TOKENS=12000
ORCHESTRATOR_ANTHROPIC_REFUSAL_FALLBACK=true

# --- Providers ----------------------------------------------------------------
# Anthropic (official API key; a Claude.ai subscription is not an API key)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# Alibaba Model Studio. Default = Token Plan endpoint (serves qwen3.8-*, deepseek-v4.1-flash, glm-5.3).
# WARNING: Token Plan terms restrict it to interactive coding tools and forbid automated
# scripts / application backends; violations can suspend the plan or revoke the key.
# For unattended orchestration prefer your region's pay-as-you-go compatible-mode endpoint.
# The Token Plan region (Beijing vs Singapore) varies by edition — check your console.
QWEN_OPENAI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=

# Direct DeepSeek API (provider disabled by default; model id `deepseek-flash`)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Direct Z.ai API (provider disabled by default). Coding Plan: https://api.z.ai/api/coding/paas/v4
GLM_OPENAI_BASE_URL=https://api.z.ai/api/paas/v4
GLM_API_KEY=

# Optional Hermes / local OpenAI-compatible server (disabled; never a default)
# HERMES_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# HERMES_API_KEY=

# --- Harness binaries (override if not on PATH under the default name) --------
# OPENCODE_COMMAND=opencode
# DEEPSEEK_HARNESS_COMMAND=dsh
# ZCODE_COMMAND=zcode-cli
# QWEN_CODE_COMMAND=qwen
# AIDER_COMMAND=aider
# CLAUDE_CLI_COMMAND=claude
